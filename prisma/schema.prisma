generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Especialidad {
  especialidadId BigInt   @id @default(autoincrement()) @map("especialidad_id")
  nombre         String   @unique @db.VarChar(120)
  descripcion    String?
  icono          String?  @db.VarChar(50)
  activa         Boolean  @default(true)
  medicos        Medico[]

  @@map("especialidad")
}

model Rol {
  rolId       BigInt    @id @default(autoincrement()) @map("rol_id")
  nombre      String    @unique @db.VarChar(50)
  descripcion String?
  activo      Boolean   @default(true)
  usuarios    Usuario[]

  @@map("rol")
}

model Usuario {
  usuarioId            BigInt                 @id @default(autoincrement()) @map("usuario_id")
  rolId                BigInt                 @map("rol_id")
  email                String                 @unique @db.VarChar(255)
  passwordHash         String                 @map("password_hash")
  estado               UsuarioEstado          @default(ACTIVO)
  fechaCreacion        DateTime               @default(now()) @map("fecha_creacion") @db.Timestamptz(6)
  ultimoAcceso         DateTime?              @map("ultimo_acceso") @db.Timestamptz(6)
  citasCreadas         CitaMedica[]           @relation("UsuarioCreaCita")
  empleado             Empleado?
  facturasEmitidas     Factura[]              @relation("UsuarioEmiteFactura")
  horariosActualizados MedicoHorario[]
  movimientos          MovimientoInventario[]
  paciente             Paciente?
  pagosRegistrados     Pago[]                 @relation("UsuarioRegistraPago")
  resultadosCargados   ResultadoLaboratorio[]
  respuestasIns        SolicitudInsumo[]      @relation("UsuarioRespondeInsumo")
  solicitudesIns       SolicitudInsumo[]      @relation("UsuarioSolicitaInsumo")
  solicitudesLab       SolicitudLaboratorio[]
  rol                  Rol                    @relation(fields: [rolId], references: [rolId])
  pedidosSolicitados   PedidoCompra[]         @relation("UsuarioSolicitaPedido")
  pedidosAprobados     PedidoCompra[]         @relation("UsuarioApruebaPedido")
  diagnosticos         Diagnostico[]
  historiasActualizadas HistoriaClinica[] @relation("UsuarioActualizaHistoria")

  @@map("usuario")
}

model Empleado {
  empleadoId          BigInt                @id @default(autoincrement()) @map("empleado_id")
  usuarioId           BigInt?               @unique @map("usuario_id")
  nombres             String                @db.VarChar(120)
  apellidos           String                @db.VarChar(120)
  documentoIdentidad  String?               @unique @map("documento_identidad") @db.VarChar(40)
  telefono            String?               @db.VarChar(40)
  correoInstitucional String?               @map("correo_institucional") @db.VarChar(255)
  fechaIngreso        DateTime?             @map("fecha_ingreso") @db.Date
  estadoLaboral       EmpleadoEstadoLaboral @default(ACTIVO) @map("estado_laboral")
  usuario             Usuario?              @relation(fields: [usuarioId], references: [usuarioId])
  medico              Medico?

  @@map("empleado")
}

model Medico {
  empleadoId          BigInt         @id @map("empleado_id")
  especialidadId      BigInt         @map("especialidad_id")
  numeroColegiatura   String?        @unique @map("numero_colegiatura") @db.VarChar(60)
  licenciaProfesional String?        @unique @map("licencia_profesional") @db.VarChar(60)
  activo              Boolean        @default(true)
  citas               CitaMedica[]
  empleado            Empleado       @relation(fields: [empleadoId], references: [empleadoId], onDelete: Cascade)
  especialidad        Especialidad   @relation(fields: [especialidadId], references: [especialidadId])
  horario             MedicoHorario?

  @@map("medico")
}

model Paciente {
  pacienteId         BigInt         @id @default(autoincrement()) @map("paciente_id")
  usuarioId          BigInt?        @unique @map("usuario_id")
  nombres            String         @db.VarChar(120)
  apellidos          String         @db.VarChar(120)
  documentoIdentidad String?        @unique @map("documento_identidad") @db.VarChar(40)
  fechaNacimiento    DateTime?      @map("fecha_nacimiento") @db.Date
  sexo               String?        @db.VarChar(20)
  telefono           String?        @db.VarChar(40)
  correo             String?        @db.VarChar(255)
  direccion          String?
  estado             PacienteEstado @default(ACTIVO)
  citas              CitaMedica[]
  usuario            Usuario?       @relation(fields: [usuarioId], references: [usuarioId])
  historiaClinica    HistoriaClinica?
  polizas            Poliza[]
  emergencias        Emergencia[]

  @@map("paciente")
}

model MedicoHorario {
  medicoHorarioId BigInt                 @id @default(autoincrement()) @map("medico_horario_id")
  medicoId        BigInt                 @unique @map("medico_id")
  actualizadoPor  BigInt                 @map("actualizado_por")
  actualizadoEn   DateTime               @default(now()) @map("actualizado_en") @db.Timestamptz(6)
  usuario         Usuario                @relation(fields: [actualizadoPor], references: [usuarioId])
  medico          Medico                 @relation(fields: [medicoId], references: [empleadoId])
  detalles        MedicoHorarioDetalle[]

  @@index([medicoId])
  @@index([actualizadoPor])
  @@map("medico_horario")
}

model MedicoHorarioDetalle {
  detalleId       BigInt        @id @default(autoincrement()) @map("detalle_id")
  medicoHorarioId BigInt        @map("medico_horario_id")
  diaSemana       DiaSemana     @map("dia_semana")
  horaInicio      DateTime      @map("hora_inicio") @db.Time(6)
  horaFin         DateTime      @map("hora_fin") @db.Time(6)
  horario         MedicoHorario @relation(fields: [medicoHorarioId], references: [medicoHorarioId], onDelete: Cascade)

  @@unique([medicoHorarioId, diaSemana, horaInicio], name: "uq_bloque_unico")
  @@index([medicoHorarioId])
  @@index([diaSemana])
  @@map("medico_horario_detalle")
}

model CitaMedica {
  citaId            BigInt                 @id @default(autoincrement()) @map("cita_id")
  pacienteId        BigInt                 @map("paciente_id")
  medicoId          BigInt                 @map("medico_id")
  fechaCita         DateTime               @map("fecha_cita") @db.Date
  horaInicio        DateTime               @map("hora_inicio") @db.Time(6)
  horaFin           DateTime               @map("hora_fin") @db.Time(6)
  motivoConsulta    String?                @map("motivo_consulta")
  estadoCita        CitaEstado             @default(PROGRAMADA) @map("estado_cita")
  tipoCita          CitaTipo               @default(CONSULTA) @map("tipo_cita")
  origenCita        CitaOrigen             @default(WEB) @map("origen_cita")
  observaciones     String?
  fechaCreacion     DateTime               @default(now()) @map("fecha_creacion") @db.Timestamptz(6)
  usuarioCreacion   BigInt                 @map("usuario_creacion")
  medico            Medico                 @relation(fields: [medicoId], references: [empleadoId])
  paciente          Paciente               @relation(fields: [pacienteId], references: [pacienteId])
  creador           Usuario                @relation("UsuarioCreaCita", fields: [usuarioCreacion], references: [usuarioId])
  documentos        DocumentoClinico[]
  factura           Factura?
  solicitudesInsumo SolicitudInsumo[]
  solicitudesLab    SolicitudLaboratorio[]
  diagnostico       Diagnostico?
  receta            Receta?
  ordenes           OrdenMedica[]
  cartasAval        CartaAval[]
  emergencia        Emergencia?

  @@unique([medicoId, fechaCita, horaInicio], name: "uq_cita_slot")
  @@map("cita_medica")
}

model MetodoPago {
  metodoPagoId BigInt  @id @default(autoincrement()) @map("metodo_pago_id")
  nombre       String  @unique @db.VarChar(80)
  descripcion  String?
  activo       Boolean @default(true)
  pagos        Pago[]

  @@map("metodo_pago")
}

model Factura {
  facturaId      BigInt           @id @default(autoincrement()) @map("factura_id")
  citaId         BigInt           @unique @map("cita_id")
  numeroFactura  String?          @unique @map("numero_factura") @db.VarChar(60)
  fechaEmision   DateTime         @default(now()) @map("fecha_emision") @db.Timestamptz(6)
  estadoFactura  FacturaEstado    @default(PENDIENTE) @map("estado_factura")
  subtotal       Decimal          @default(0) @db.Decimal(12, 2)
  descuentoTotal Decimal          @default(0) @map("descuento_total") @db.Decimal(12, 2)
  impuestoTotal  Decimal          @default(0) @map("impuesto_total") @db.Decimal(12, 2)
  total          Decimal          @default(0) @db.Decimal(12, 2)
  saldoPendiente Decimal          @default(0) @map("saldo_pendiente") @db.Decimal(12, 2)
  montoAsegurado Decimal          @default(0) @map("monto_asegurado") @db.Decimal(12, 2)
  observaciones  String?
  usuarioEmision BigInt           @map("usuario_emision")
  cita           CitaMedica       @relation(fields: [citaId], references: [citaId])
  emisor         Usuario          @relation("UsuarioEmiteFactura", fields: [usuarioEmision], references: [usuarioId])
  detalles       FacturaDetalle[]
  pagos          Pago[]

  @@map("factura")
}

model FacturaDetalle {
  detalleId      BigInt          @id @default(autoincrement()) @map("detalle_id")
  facturaId      BigInt          @map("factura_id")
  tipoItem       FacturaItemTipo @map("tipo_item")
  descripcion    String
  cantidad       Decimal         @db.Decimal(12, 2)
  precioUnitario Decimal         @map("precio_unitario") @db.Decimal(12, 2)
  importe        Decimal         @db.Decimal(12, 2)
  referenciaId   BigInt?         @map("referencia_id")
  factura        Factura         @relation(fields: [facturaId], references: [facturaId], onDelete: Cascade)

  @@map("factura_detalle")
}

model Pago {
  pagoId            BigInt     @id @default(autoincrement()) @map("pago_id")
  facturaId         BigInt     @map("factura_id")
  monto             Decimal    @db.Decimal(12, 2)
  fechaPago         DateTime   @default(now()) @map("fecha_pago") @db.Timestamptz(6)
  fechaRegistro     DateTime   @default(now()) @map("fecha_registro") @db.Timestamptz(6) // New System Timestamp
  estadoPago        PagoEstado @default(PENDIENTE) @map("estado_pago")
  metodoPagoId      BigInt     @map("metodo_pago_id")
  referenciaExterna String?    @map("referencia_externa") @db.VarChar(120)
  canalPago         PagoCanal  @default(PRESENCIAL) @map("canal_pago")
  montoBs           Decimal?   @map("monto_bs") @db.Decimal(12, 2)
  tasaCambio        Decimal?   @map("tasa_cambio") @db.Decimal(10, 2)
  usuarioRegistro   BigInt     @map("usuario_registro")
  cuentaBancariaId  Int?       @map("cuenta_bancaria_id")
  factura           Factura    @relation(fields: [facturaId], references: [facturaId])
  metodoPago        MetodoPago @relation(fields: [metodoPagoId], references: [metodoPagoId])
  registrador       Usuario    @relation("UsuarioRegistraPago", fields: [usuarioRegistro], references: [usuarioId])
  cuentaBancaria    CuentaBancaria? @relation(fields: [cuentaBancariaId], references: [cuentaId])

  @@map("pago")
}

model Insumo {
  insumoId           BigInt                   @id @default(autoincrement()) @map("insumo_id")
  codigo             String                   @unique @db.VarChar(60)
  nombre             String                   @db.VarChar(120)
  marca              String                   @default("Genérico") @db.VarChar(80)
  descripcion        String?
  unidadMedida       String                   @map("unidad_medida") @db.VarChar(40)
  categoria          String                   @db.VarChar(60)
  activo             Boolean                  @default(true)
  detalleMovimientos MovimientoDetalle[]
  detalleSolicitudes SolicitudInsumoDetalle[]
  pedidoDetalles     PedidoCompraDetalle[]
  stock              Stock[]
  lotes              Lote[]

  @@map("insumo")
}

model Almacen {
  almacenId   BigInt                 @id @default(autoincrement()) @map("almacen_id")
  nombre      String                 @unique @db.VarChar(80)
  descripcion String?
  activo      Boolean                @default(true)
  movimientos MovimientoInventario[]
  stock       Stock[]
  stockLote   StockLote[]

  @@map("almacen")
}

model Stock {
  stockId        BigInt   @id @default(autoincrement()) @map("stock_id")
  almacenId      BigInt   @map("almacen_id")
  insumoId       BigInt   @map("insumo_id")
  cantidadActual Decimal  @default(0) @map("cantidad_actual") @db.Decimal(14, 2)
  stockMinimo    Decimal  @default(0) @map("stock_minimo") @db.Decimal(12, 2)
  actualizadoEn  DateTime @default(now()) @map("actualizado_en") @db.Timestamptz(6)
  almacen        Almacen  @relation(fields: [almacenId], references: [almacenId])
  insumo         Insumo   @relation(fields: [insumoId], references: [insumoId])

  @@unique([almacenId, insumoId], name: "uq_stock")
  @@map("stock")
}

model Proveedor {
  proveedorId BigInt                 @id @default(autoincrement()) @map("proveedor_id")
  nombre      String                 @db.VarChar(160)
  rifNif      String?                @unique @map("rif_nif") @db.VarChar(40)
  telefono    String?                @db.VarChar(40)
  correo      String?                @db.VarChar(255)
  direccion   String?
  activo      Boolean                @default(true)
  pedidosDetalle PedidoCompraDetalle[]

  @@map("proveedor")
}

model SolicitudInsumo {
  solicitudInsumoId BigInt                   @id @default(autoincrement()) @map("solicitud_insumo_id")
  citaId            BigInt                   @map("cita_id")
  usuarioSolicita   BigInt                   @map("usuario_solicita")
  fechaSolicitud    DateTime                 @default(now()) @map("fecha_solicitud") @db.Timestamptz(6)
  estadoSolicitud   SolicitudInsumoEstado    @default(PENDIENTE) @map("estado_solicitud")
  usuarioResponde   BigInt?                  @map("usuario_responde")
  fechaRespuesta    DateTime?                @map("fecha_respuesta") @db.Timestamptz(6)
  observaciones     String?
  movimientos       MovimientoInventario[]
  cita              CitaMedica               @relation(fields: [citaId], references: [citaId])
  respondedor       Usuario?                 @relation("UsuarioRespondeInsumo", fields: [usuarioResponde], references: [usuarioId])
  solicitante       Usuario                  @relation("UsuarioSolicitaInsumo", fields: [usuarioSolicita], references: [usuarioId])
  detalles          SolicitudInsumoDetalle[]

  @@map("solicitud_insumo")
}

model SolicitudInsumoDetalle {
  solicitudDetalleId BigInt          @id @default(autoincrement()) @map("solicitud_detalle_id")
  solicitudInsumoId  BigInt          @map("solicitud_insumo_id")
  insumoId           BigInt          @map("insumo_id")
  cantidadSolicitada Decimal         @map("cantidad_solicitada") @db.Decimal(14, 2)
  cantidadAprobada   Decimal?        @map("cantidad_aprobada") @db.Decimal(14, 2)
  insumo             Insumo          @relation(fields: [insumoId], references: [insumoId])
  solicitud          SolicitudInsumo @relation(fields: [solicitudInsumoId], references: [solicitudInsumoId], onDelete: Cascade)

  @@unique([solicitudInsumoId, insumoId], name: "uq_solins_det")
  @@map("solicitud_insumo_detalle")
}

model MovimientoInventario {
  movimientoId      BigInt              @id @default(autoincrement()) @map("movimiento_id")
  almacenId         BigInt              @map("almacen_id")
  tipoMovimiento    MovimientoTipo      @map("tipo_movimiento")
  fechaMovimiento   DateTime            @default(now()) @map("fecha_movimiento") @db.Timestamptz(6)
  usuarioId         BigInt              @map("usuario_id")
  solicitudInsumoId BigInt?             @map("solicitud_insumo_id")
  pedidoCompraId    BigInt?             @map("pedido_compra_id")
  referencia        String?             @db.VarChar(120)
  observaciones     String?
  detalles          MovimientoDetalle[]
  almacen           Almacen             @relation(fields: [almacenId], references: [almacenId])
  solicitudInsumo   SolicitudInsumo?    @relation(fields: [solicitudInsumoId], references: [solicitudInsumoId])
  pedidoCompra      PedidoCompra?       @relation(fields: [pedidoCompraId], references: [pedidoId])
  usuario           Usuario             @relation(fields: [usuarioId], references: [usuarioId])

  @@map("movimiento_inventario")
}

model MovimientoDetalle {
  movimientoDetalleId BigInt               @id @default(autoincrement()) @map("movimiento_detalle_id")
  movimientoId        BigInt               @map("movimiento_id")
  insumoId            BigInt               @map("insumo_id")
  loteId              BigInt?              @map("lote_id")
  cantidad            Decimal              @db.Decimal(14, 2)
  insumo              Insumo               @relation(fields: [insumoId], references: [insumoId])
  movimiento          MovimientoInventario @relation(fields: [movimientoId], references: [movimientoId], onDelete: Cascade)
  lote                Lote?                @relation(fields: [loteId], references: [loteId])

  @@map("movimiento_detalle")
}

model ExamenLaboratorio {
  examenId    BigInt                        @id @default(autoincrement()) @map("examen_id")
  nombre      String                        @unique @db.VarChar(120)
  descripcion String?
  activo      Boolean                       @default(true)
  detalles    SolicitudLaboratorioDetalle[]

  @@map("examen_laboratorio")
}

model SolicitudLaboratorio {
  solicitudLabId  BigInt                        @id @default(autoincrement()) @map("solicitud_lab_id")
  citaId          BigInt                        @map("cita_id")
  usuarioSolicita BigInt                        @map("usuario_solicita")
  fechaSolicitud  DateTime                      @default(now()) @map("fecha_solicitud") @db.Timestamptz(6)
  estadoSolicitud SolicitudLabEstado            @default(PENDIENTE) @map("estado_solicitud")
  observaciones   String?
  cita            CitaMedica                    @relation(fields: [citaId], references: [citaId])
  solicitante     Usuario                       @relation(fields: [usuarioSolicita], references: [usuarioId])
  detalles        SolicitudLaboratorioDetalle[]

  @@map("solicitud_laboratorio")
}

model SolicitudLaboratorioDetalle {
  detalleLabId   BigInt                @id @default(autoincrement()) @map("detalle_lab_id")
  solicitudLabId BigInt                @map("solicitud_lab_id")
  examenId       BigInt                @map("examen_id")
  resultado      ResultadoLaboratorio?
  examen         ExamenLaboratorio     @relation(fields: [examenId], references: [examenId])
  solicitud      SolicitudLaboratorio  @relation(fields: [solicitudLabId], references: [solicitudLabId], onDelete: Cascade)

  @@unique([solicitudLabId, examenId], name: "uq_sollab_det")
  @@map("solicitud_laboratorio_detalle")
}

model ResultadoLaboratorio {
  resultadoId        BigInt                      @id @default(autoincrement()) @map("resultado_id")
  detalleLabId       BigInt                      @unique @map("detalle_lab_id")
  fechaResultado     DateTime                    @default(now()) @map("fecha_resultado") @db.Timestamptz(6)
  observacionGeneral String?                     @map("observacion_general")
  usuarioCarga       BigInt                      @map("usuario_carga")
  documentos         DocumentoClinico?
  detalleSol         SolicitudLaboratorioDetalle @relation(fields: [detalleLabId], references: [detalleLabId])
  cargador           Usuario                     @relation(fields: [usuarioCarga], references: [usuarioId])

  @@map("resultado_laboratorio")
}

model DocumentoClinico {
  documentoId   BigInt               @id @default(autoincrement()) @map("documento_id")
  resultadoId   BigInt               @unique @map("resultado_id")
  citaId        BigInt               @map("cita_id")
  nombreArchivo String               @map("nombre_archivo") @db.VarChar(255)
  rutaArchivo   String               @map("ruta_archivo")
  tipoDocumento DocumentoTipo        @default(RESULTADO_LAB) @map("tipo_documento")
  fechaCarga    DateTime             @default(now()) @map("fecha_carga") @db.Timestamptz(6)
  cita          CitaMedica           @relation(fields: [citaId], references: [citaId])
  resultado     ResultadoLaboratorio @relation(fields: [resultadoId], references: [resultadoId])

  @@map("documento_clinico")
}

enum UsuarioEstado {
  ACTIVO
  INACTIVO
  BLOQUEADO
}

enum PacienteEstado {
  ACTIVO
  INACTIVO
  BLOQUEADO
  FALLECIDO
}

enum EmpleadoEstadoLaboral {
  ACTIVO
  VACACIONES
  LICENCIA
  SUSPENDIDO
  RETIRADO
}

enum CitaEstado {
  PROGRAMADA
  CONFIRMADA
  ATENDIDA
  CANCELADA
  NO_ASISTIO
}

enum CitaOrigen {
  WEB
  RECEPCION
}

enum CitaTipo {
  CONSULTA
  CONTROL
  ESPECIALIDAD
  EMERGENCIA
  OTRA
}

enum FacturaEstado {
  PENDIENTE
  PARCIAL
  PAGADA
  ANULADA
}

enum FacturaItemTipo {
  SERVICIO
  INSUMO
  EXAMEN
  OTRO
}

enum PagoEstado {
  PENDIENTE
  VALIDADO
  RECHAZADO
  ANULADO
}

enum PagoCanal {
  ONLINE
  PRESENCIAL
  SEGURO
}

enum MovimientoTipo {
  ENTRADA
  SALIDA
  AJUSTE
  TRASLADO
}

enum SolicitudInsumoEstado {
  PENDIENTE
  APROBADA
  RECHAZADA
  DESPACHADA
}

enum SolicitudLabEstado {
  PENDIENTE
  APROBADA
  RECHAZADA
  ATENDIDA
}

enum DocumentoTipo {
  RESULTADO_LAB
  INFORME
  OTRO
}

enum DiaSemana {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
  DOMINGO
}

model TasaDeCambio {
  tasaId       Int      @id @default(autoincrement()) @map("tasa_id")
  moneda       String   @default("USD") @db.VarChar(10)
  valor        Decimal  @db.Decimal(10, 2)
  fecha        DateTime @default(now()) @db.Timestamptz(6)
  fuente       String?  @db.VarChar(50)
  esAutomatica Boolean  @default(true) @map("es_automatica")

  @@map("tasa_de_cambio")
}

model PedidoCompra {
  pedidoId          BigInt                @id @default(autoincrement()) @map("pedido_id")
  usuarioSolicita   BigInt                @map("usuario_solicita")
  fechaSolicitud    DateTime              @default(now()) @map("fecha_solicitud") @db.Timestamptz(6)
  estado            PedidoEstado          @default(PENDIENTE)
  usuarioAprueba    BigInt?               @map("usuario_aprueba")
  fechaAprobacion   DateTime?             @map("fecha_aprobacion") @db.Timestamptz(6)
  observaciones     String?
  detalles          PedidoCompraDetalle[]
  movimientos       MovimientoInventario[]
  solicitante       Usuario               @relation("UsuarioSolicitaPedido", fields: [usuarioSolicita], references: [usuarioId])
  aprobador         Usuario?              @relation("UsuarioApruebaPedido", fields: [usuarioAprueba], references: [usuarioId])

  @@map("pedido_compra")
}

model PedidoCompraDetalle {
  detalleId       BigInt       @id @default(autoincrement()) @map("detalle_id")
  pedidoId        BigInt       @map("pedido_id")
  insumoId        BigInt       @map("insumo_id")
  cantidad        Decimal      @db.Decimal(14, 2)
  proveedorId     BigInt?      @map("proveedor_id")
  pedido          PedidoCompra @relation(fields: [pedidoId], references: [pedidoId], onDelete: Cascade)
  insumo          Insumo       @relation(fields: [insumoId], references: [insumoId])
  proveedor       Proveedor?   @relation(fields: [proveedorId], references: [proveedorId])

  @@map("pedido_compra_detalle")
}

model Lote {
  loteId           BigInt        @id @default(autoincrement()) @map("lote_id")
  insumoId         BigInt        @map("insumo_id")
  codigo           String        @db.VarChar(60)
  fechaVencimiento DateTime?     @map("fecha_vencimiento") @db.Date
  fechaFabricacion DateTime?     @map("fecha_fabricacion") @db.Date
  activo           Boolean       @default(true)
  insumo           Insumo        @relation(fields: [insumoId], references: [insumoId])
  stock            StockLote[]
  movimientos      MovimientoDetalle[]

  @@unique([insumoId, codigo], name: "uq_lote_insumo")
  @@map("lote")
}

model StockLote {
  stockLoteId    BigInt   @id @default(autoincrement()) @map("stock_lote_id")
  almacenId      BigInt   @map("almacen_id")
  loteId         BigInt   @map("lote_id")
  cantidadActual Decimal  @default(0) @map("cantidad_actual") @db.Decimal(14, 2)
  almacen        Almacen  @relation(fields: [almacenId], references: [almacenId])
  lote           Lote     @relation(fields: [loteId], references: [loteId])

  @@unique([almacenId, loteId], name: "uq_stock_lote")
  @@map("stock_lote")
}

enum PedidoEstado {
  PENDIENTE
  APROBADO
  RECHAZADO
  DESPACHADO
}

model Configuracion {
  clave         String   @id @db.VarChar(50)
  valor         String
  descripcion   String?
  actualizadoEn DateTime @default(now()) @map("actualizado_en")

  @@map("configuracion")
}

model CuentaBancaria {
  cuentaId      Int      @id @default(autoincrement()) @map("cuenta_id")
  banco         String   @db.VarChar(80)
  numeroCuenta  String   @unique @map("numero_cuenta") @db.VarChar(50)
  titular       String   @db.VarChar(120)
  rifTitular    String   @map("rif_titular") @db.VarChar(20)
  tipo              String   @default("CORRIENTE") @db.VarChar(20)
  activa        Boolean  @default(true)
  pagos         Pago[]
  
  @@map("cuenta_bancaria")
}

model Diagnostico {
  diagnosticoId BigInt            @id @default(autoincrement()) @map("diagnostico_id")
  citaId        BigInt            @unique @map("cita_id")
  descripcion   String            @db.Text

  notas         String?           @db.Text
  fechaRegistro DateTime          @default(now()) @map("fecha_registro") @db.Timestamptz(6)
  usuarioId     BigInt            @map("usuario_id") // Doctor who recorded it
  cita          CitaMedica        @relation(fields: [citaId], references: [citaId], onDelete: Cascade)
  medico        Usuario           @relation(fields: [usuarioId], references: [usuarioId])

  @@map("diagnostico")
}

model Receta {
  recetaId      BigInt          @id @default(autoincrement()) @map("receta_id")
  citaId        BigInt          @unique @map("cita_id")
  fecha         DateTime        @default(now()) @db.Date
  detalles      RecetaDetalle[]
  cita          CitaMedica      @relation(fields: [citaId], references: [citaId], onDelete: Cascade)

  @@map("receta")
}

model RecetaDetalle {
  detalleId     BigInt   @id @default(autoincrement()) @map("detalle_id")
  recetaId      BigInt   @map("receta_id")
  medicamento   String   @db.VarChar(120)
  dosis         String   @db.VarChar(60)
  frecuencia    String   @db.VarChar(60)
  duracion      String   @db.VarChar(60)
  instrucciones String?  @db.Text
  receta        Receta   @relation(fields: [recetaId], references: [recetaId], onDelete: Cascade)

  @@map("receta_detalle")
}

model OrdenMedica {
  ordenId       BigInt     @id @default(autoincrement()) @map("orden_id")
  citaId        BigInt     @map("cita_id")
  tipo          String     @db.VarChar(50) // LABORATORIO, IMAGENOLOGIA, OTRO
  estudio       String     @db.VarChar(150)
  fechaCreacion DateTime   @default(now()) @map("fecha_creacion") @db.Timestamptz(6)
  cita          CitaMedica @relation(fields: [citaId], references: [citaId], onDelete: Cascade)

  @@map("orden_medica")
}


model HistoriaClinica {
  historiaId  Int      @id @default(autoincrement()) @map("historia_id")
  pacienteId  BigInt   @unique @map("paciente_id")
  contenido   Json
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById BigInt?  @map("updated_by_id")
  
  paciente    Paciente @relation(fields: [pacienteId], references: [pacienteId])
  updatedBy   Usuario? @relation("UsuarioActualizaHistoria", fields: [updatedById], references: [usuarioId])

  @@map("historia_clinica")
}

// ========== SEGUROS MÉDICOS ==========

model Aseguradora {
  aseguradoraId BigInt   @id @default(autoincrement()) @map("aseguradora_id")
  nombre        String   @unique @db.VarChar(160)
  rifNif        String?  @unique @map("rif_nif") @db.VarChar(40)
  telefono      String?  @db.VarChar(40)
  correo        String?  @db.VarChar(255)
  direccion     String?
  activa        Boolean  @default(true)
  polizas       Poliza[]

  @@map("aseguradora")
}

model Poliza {
  polizaId      BigInt       @id @default(autoincrement()) @map("poliza_id")
  pacienteId    BigInt       @map("paciente_id")
  aseguradoraId BigInt       @map("aseguradora_id")
  numeroPoliza  String       @map("numero_poliza") @db.VarChar(60)
  tipoCobertura String?      @map("tipo_cobertura") @db.VarChar(80)
  fechaInicio   DateTime?    @map("fecha_inicio") @db.Date
  fechaVence    DateTime?    @map("fecha_vence") @db.Date
  estado        PolizaEstado @default(ACTIVA)
  observaciones String?
  paciente      Paciente     @relation(fields: [pacienteId], references: [pacienteId])
  aseguradora   Aseguradora  @relation(fields: [aseguradoraId], references: [aseguradoraId])
  cartasAval    CartaAval[]

  @@unique([pacienteId, aseguradoraId, numeroPoliza], name: "uq_poliza")
  @@map("poliza")
}

model CartaAval {
  cartaAvalId    BigInt          @id @default(autoincrement()) @map("carta_aval_id")
  polizaId       BigInt          @map("poliza_id")
  citaId         BigInt?         @map("cita_id")
  emergenciaId   BigInt?         @map("emergencia_id")
  codigoAval     String?         @map("codigo_aval") @db.VarChar(80)
  montoAprobado  Decimal?        @map("monto_aprobado") @db.Decimal(12, 2)
  estado         CartaAvalEstado @default(SOLICITADA)
  fechaSolicitud DateTime        @default(now()) @map("fecha_solicitud") @db.Timestamptz(6)
  fechaRespuesta DateTime?       @map("fecha_respuesta") @db.Timestamptz(6)
  observaciones  String?
  poliza         Poliza          @relation(fields: [polizaId], references: [polizaId])
  cita           CitaMedica?     @relation(fields: [citaId], references: [citaId])
  emergencia     Emergencia?     @relation(fields: [emergenciaId], references: [emergenciaId])

  @@map("carta_aval")
}

// ========== EMERGENCIAS ==========

model Emergencia {
  emergenciaId     BigInt             @id @default(autoincrement()) @map("emergencia_id")
  pacienteId       BigInt             @map("paciente_id")
  citaId           BigInt?            @unique @map("cita_id")
  motivoIngreso    String             @map("motivo_ingreso")
  nivelUrgencia    NivelUrgencia      @default(MODERADO) @map("nivel_urgencia")
  estadoEmergencia EmergenciaEstado   @default(TRIAJE) @map("estado_emergencia")
  verificacionPago VerificacionPago   @default(PENDIENTE) @map("verificacion_pago")
  tipoPago         TipoPagoEmergencia @default(PENDIENTE) @map("tipo_pago")
  fechaIngreso     DateTime           @default(now()) @map("fecha_ingreso") @db.Timestamptz(6)
  fechaAlta        DateTime?          @map("fecha_alta") @db.Timestamptz(6)
  observaciones    String?
  paciente         Paciente           @relation(fields: [pacienteId], references: [pacienteId])
  cita             CitaMedica?        @relation(fields: [citaId], references: [citaId])
  cartasAval       CartaAval[]

  @@map("emergencia")
}

enum PolizaEstado {
  ACTIVA
  VENCIDA
  SUSPENDIDA
}

enum CartaAvalEstado {
  SOLICITADA
  APROBADA
  RECHAZADA
  PENDIENTE_PAGO
}

enum NivelUrgencia {
  CRITICO
  URGENTE
  MODERADO
  LEVE
}

enum EmergenciaEstado {
  TRIAJE
  EN_ATENCION
  HOSPITALIZADO
  CIRUGIA_URGENTE
  REFERIDO
  ALTA
}

enum VerificacionPago {
  PENDIENTE
  CONFIRMADO
  SIN_COBERTURA
}

enum TipoPagoEmergencia {
  PARTICULAR
  ASEGURADO
  PENDIENTE
}
